DATABASE_URL="mysql://username:password@host:3306/database"
JWT_SECRET="change_this_secret"
JWT_EXPIRES_IN="1d"

# Phase 14 — expiry scheduler / external cron
CRON_SECRET="change_this_cron_secret"
EXPIRY_JOB_ENABLED="false"
# interval in milliseconds (default 1 hour)
EXPIRY_JOB_INTERVAL_MS="3600000"
